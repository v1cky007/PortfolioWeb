<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a2e"/>
      <stop offset="100%" style="stop-color:#16213e"/>
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#BF00FF"/>
      <stop offset="100%" style="stop-color:#8A2BE2"/>
    </linearGradient>
  </defs>
  <rect width="600" height="400" fill="url(#bg)"/>
  <rect x="40" y="40" width="520" height="320" rx="16" fill="none" stroke="url(#accent)" stroke-width="2" opacity="0.3"/>
  <circle cx="300" cy="160" r="50" fill="none" stroke="url(#accent)" stroke-width="3"/>
  <path d="M285 160 L295 170 L315 150" stroke="#BF00FF" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  <text x="300" y="240" text-anchor="middle" font-family="system-ui, sans-serif" font-size="24" font-weight="700" fill="white">Grocery Store</text>
  <text x="300" y="270" text-anchor="middle" font-family="system-ui, sans-serif" font-size="14" fill="#9CA3AF">E-Commerce Platform</text>
  <rect x="200" y="290" width="200" height="4" rx="2" fill="url(#accent)" opacity="0.5"/>
  <circle cx="120" cy="100" r="8" fill="#BF00FF" opacity="0.2"/>
  <circle cx="480" cy="300" r="12" fill="#8A2BE2" opacity="0.15"/>
  <circle cx="500" cy="80" r="6" fill="#DA70D6" opacity="0.2"/>
</svg>